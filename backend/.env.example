# ============================================
# LVLUP — Variables de Entorno del Backend
# ============================================
# Copia este archivo y renómbralo a '.env'
# ============================================

# ---- Conexión a Base de Datos (PostgreSQL) ----
# Si usas Docker (docker-compose):
# DATABASE_URL="postgresql://postgres:admin123@localhost:5432/lvlup_db?schema=public"
#
# Si usas PostgreSQL instalado directo en tu PC (pgAdmin / Windows Service):
# Cambia "TU_PASSWORD" por la clave que le pusiste a tu PostgreSQL al instalarlo:
DATABASE_URL="postgresql://postgres:TU_PASSWORD@localhost:5432/lvlup_db?schema=public"

# ---- Servidor ----
PORT=3000
NODE_ENV=development

# ---- Autenticación (JWT) ----
JWT_SECRET="lvlup_ultra_secret_key_jwt_2026_gamer"
