generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ENUMS
enum AdminRole {
  SUPERADMIN
  STAFF
}

enum MenuCategory {
  COCTELES
  BURGERS
  SUSHI
  SNACKS
  LICORES
  SERVICIOS
}

enum StationType {
  CONSOLA
  MESA
}

// MODELS

// Administradores y Personal
model AdminUser {
  id        String    @id @default(uuid())
  email     String    @unique
  password  String    // Hashed password (bcrypt)
  name      String
  role      AdminRole @default(STAFF)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

// Catálogo de Menú Digital
model MenuItem {
  id          String       @id @default(uuid())
  name        String
  description String?
  price       Float
  category    MenuCategory
  photoUrl    String?
  isAvailable Boolean      @default(true) // Botón de pánico de stock
  isPopular   Boolean      @default(false)
  promoTag    String?      // e.g. "2x1"
  tags        String[]     @default([])
  ingredients String[]     @default([])
  orderIndex  Int          @default(0)

  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

// Estaciones de Juego (Consolas y Juegos de Salón)
model GamingStation {
  id          String      @id @default(uuid())
  name        String
  type        StationType
  price30min  Float       @default(3.00)
  price1hour  Float       @default(6.00)
  description String?
  features    String[]    @default([])
  isAvailable Boolean     @default(true)
  orderIndex  Int         @default(0)

  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
}

// Promociones Activas
model Promo {
  id          String   @id @default(uuid())
  title       String
  description String
  days        String[] @default([])
  startTime   String?  // e.g. "16:00"
  endTime     String?  // e.g. "19:00"
  promoPrice  Float?
  isActive    Boolean  @default(true)
  tag         String?  // e.g. "HAPPY HOUR"
  color       String   @default("pink") // pink | cyan | purple

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// Información General del Negocio
model BusinessInfo {
  id        String   @id @default("default")
  name      String   @default("LVLUP Game Bar & Lounge")
  slogan    String   @default("Juega, Come, Vive la Noche")
  address   String   @default("Centro Comercial Las Virtudes, Valencia, Venezuela")
  whatsapp  String   @default("+58 424-0000000")
  instagram String   @default("@lvlup_gamebar")
  hoursJson Json?    // Horarios por día de la semana

  updatedAt DateTime @updatedAt
}

